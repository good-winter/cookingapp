# 复制为 .env 并填入真实值。.env 不进版本库。

APP_ADDR=:8080
APP_ENV=development
APP_AUTO_MIGRATE=true

# charset=utf8mb4 必须保留，否则中文菜名无法写入。
# parseTime=true 让 DATETIME 直接扫描为 time.Time。
# loc=UTC 表示数据库中的时间一律按 UTC 处理。
# multiStatements=true 让迁移文件可以整份执行。
APP_DSN=root:你的密码@tcp(127.0.0.1:3306)/cookingapp?parseTime=true&loc=UTC&charset=utf8mb4&multiStatements=true

# 短信验证码登录。**这两项只在 APP_ENV=development 下生效**：
# 非开发环境一律用随机码，且响应里不会回显 devCode。
# 开发期不真发短信（见 internal/auth/sender.go 的 DevSender），
# 验证码既打在后端日志里，也通过 devCode 回给前端。
APP_SMS_CODE=123456
APP_SMS_CODE_TTL=5m
